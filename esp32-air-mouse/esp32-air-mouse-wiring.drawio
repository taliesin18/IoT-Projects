<mxfile host="app.diagrams.net" modified="2026-10-06T00:00:00.000Z" agent="Codex" version="24.8.0">
  <diagram id="esp32-air-mouse" name="ESP32 Air Mouse Wiring">
    <mxGraphModel dx="1600" dy="1020" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="ESP32 Air Mouse — prototype wiring schematic&#xa;ESP32 DevKit 30-pin • common 3V3/GND • direct shared I²C" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="900" height="70" as="geometry"/></mxCell>
        <mxCell id="esp" value="ESP32 DevKit (30-pin)&#xa;&#xa;3V3 / GND&#xa;GPIO21 — SDA&#xa;GPIO22 — SCL&#xa;&#xa;GPIO34 — joystick VRx&#xa;GPIO35 — joystick VRy&#xa;GPIO25 — FIRE&#xa;GPIO26 — ACTION&#xa;GPIO27 — BLE LED&#xa;GPIO32 — sensitivity wiper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfdff;strokeColor=#194f8c;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="615" y="170" width="370" height="570" as="geometry"/></mxCell>
        <mxCell id="mpu" value="MPU6050 / GY-521&#xa;&#xa;VCC → 3V3&#xa;GND → GND&#xa;SDA → GPIO21&#xa;SCL → GPIO22" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfdff;strokeColor=#194f8c;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="330" height="175" as="geometry"/></mxCell>
        <mxCell id="oled" value="0.96-inch I²C OLED&#xa;&#xa;VCC → 3V3&#xa;GND → GND&#xa;SDA → GPIO21&#xa;SCL → GPIO22" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfdff;strokeColor=#194f8c;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="455" width="330" height="175" as="geometry"/></mxCell>
        <mxCell id="joy" value="Joystick&#xa;&#xa;VCC → 3V3&#xa;GND → GND&#xa;VRx → GPIO34&#xa;VRy → GPIO35" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfdff;strokeColor=#194f8c;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1120" y="155" width="350" height="170" as="geometry"/></mxCell>
        <mxCell id="pot" value="Sensitivity potentiometer&#xa;&#xa;outer terminals → 3V3, GND&#xa;wiper → GPIO32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfdff;strokeColor=#194f8c;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1120" y="395" width="350" height="140" as="geometry"/></mxCell>
        <mxCell id="buttons" value="Buttons&#xa;&#xa;GPIO25 → FIRE switch → GND&#xa;GPIO26 → ACTION switch → GND&#xa;(firmware uses INPUT_PULLUP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfdff;strokeColor=#194f8c;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1120" y="640" width="350" height="125" as="geometry"/></mxCell>
        <mxCell id="led" value="BLE status LED&#xa;GPIO27 → 220–330 Ω → LED → GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfdff;strokeColor=#194f8c;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="615" y="825" width="370" height="100" as="geometry"/></mxCell>
        <mxCell id="i2c1" value="SDA (GPIO21)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#1677c8;endArrow=none;" edge="1" parent="1" source="mpu" target="esp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i2c2" value="SCL (GPIO22)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#1677c8;endArrow=none;" edge="1" parent="1" source="oled" target="esp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wirejoy" value="GPIO34 / GPIO35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#1677c8;endArrow=none;" edge="1" parent="1" source="esp" target="joy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wirepot" value="GPIO32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#1677c8;endArrow=none;" edge="1" parent="1" source="esp" target="pot"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wirebtn" value="GPIO25 / GPIO26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#1677c8;endArrow=none;" edge="1" parent="1" source="esp" target="buttons"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="wireled" value="GPIO27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#1677c8;endArrow=none;" edge="1" parent="1" source="esp" target="led"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Use the 3V3 and GND pins of the ESP32 as common rails for every module.&#xa;Expected I²C: MPU6050 0x68; OLED typically 0x3C (sometimes 0x3D)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="490" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
